      ]
    },
    {
      "name": "Cadastro avulso (RJ)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "pm.collectionVariables.set('documento', '123456789' + String(ts % 100).padStart(2, '0'));",
              "pm.collectionVariables.set('numeroInstalacao', 'INST-RJ-' + ts);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    pm.test('Endereço do cliente RJ com ViaCEP', () => utils.assertRioDeJaneiroRj(body.endereco, 'Sala 3'));",
              "    pm.test('Endereço da UC RJ com ViaCEP', () => {",
              "        utils.assertRioDeJaneiroRj(body.unidadesConsumidoras[0].endereco);",
              "        pm.expect(body.unidadesConsumidoras[0].endereco.complemento).to.eql('Sem complemento');",
              "    });",
              "}"
            ]
          }
        }
